# Ingestion & APIs
APIFY_TOKEN=
EXA_API_KEY=

# LLM Configuration (Groq / OpenAI compatible)
# Option 1: Direct Groq Key (Auto-configures to https://api.groq.com/openai/v1 and llama-3.3-70b-versatile)
GROQ_API_KEY=

# Option 2: Generic LLM endpoint
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Cache & Storage
DATA_DIR=data
RAW_CACHE_ENABLED=true
LLM_CACHE_ENABLED=true
